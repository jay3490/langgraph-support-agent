# Copy to .env and adjust. Every setting is optional; the defaults run with no credentials.

# fake (scripted, no network) or openai (any OpenAI-compatible endpoint)
SUPPORT_PROVIDER=fake

# For OpenAI itself:
# SUPPORT_MODEL=gpt-4o-mini
# SUPPORT_OPENAI_API_KEY=sk-...

# For a local Ollama server:
# SUPPORT_MODEL=llama3.2
# SUPPORT_OPENAI_BASE_URL=http://localhost:11434/v1

SUPPORT_DATABASE_PATH=var/support.db
SUPPORT_CHECKPOINT_PATH=var/checkpoints.db
SUPPORT_KB_DIR=kb
SUPPORT_REFUND_APPROVAL_THRESHOLD=100.00
SUPPORT_REFUND_WINDOW_DAYS=30
SUPPORT_GOLD_REFUND_WINDOW_DAYS=45
SUPPORT_MAX_TOOL_STEPS=8
SUPPORT_MAX_HANDOFFS=2
SUPPORT_LOG_LEVEL=INFO
